#!/usr/bin/env python3
"""Git worktrees for coding agents, one folder per chat, removed only when the work is safe.

  agent-worktree new <task> [<repo>[=<ref>]...] [--branch <name>] [--no-fetch]
      Make a worktree of each repo for <task> in ~/worktrees/<project>/<chat>/<task>/<repo>.
      <repo> is a repo folder name in the project, a unique "-<name>" suffix of one, or a path.
      With no repo, the repo you're in. Starts from <ref>, default origin's default branch
      after a fetch. --branch creates or checks out that branch; without it the checkout is
      detached. Run it again with the same task to add more repos.
  agent-worktree done <task>
      Remove <task>'s worktrees. Refuses, and removes nothing, if any checkout has uncommitted
      changes or commits that aren't on a remote branch (or a GitHub PR head, if gh works).
  agent-worktree list [--all]
      Show this chat's tasks and checkouts (--all: every chat).
  agent-worktree clean [--idle-hours N] [--dry-run]
      Remove every task folder under ~/worktrees that is safe (as for done), untouched for N
      hours (default 24) and not anyone's working directory. Meant for a daily schedule.

The chat is the top-level conversation, so agents started by agents share one folder. It comes
from AGENT_WORKTREE_CHAT, else T3 Code's thread lineage, else CLAUDE_CODE_SESSION_ID or
CODEX_THREAD_ID. Branches are never deleted. https://github.com/sanvithreddyy/agent-worktree
"""
import hashlib, json, os, re, shutil, sqlite3, subprocess, sys, time

ROOT = os.path.expanduser(os.environ.get("AGENT_WORKTREE_ROOT", "~/worktrees"))
T3_DB = os.path.expanduser(os.environ.get("AGENT_WORKTREE_T3_DB", "~/.t3/userdata/statev2.sqlite"))
CHAT_FILE, TASK_FILE = ".chat.json", ".agent-worktree.json"
RECORDS = {CHAT_FILE, TASK_FILE, ".DS_Store"}
NOISE = {"node_modules", ".DS_Store"}  # untracked entries that don't count as unsaved work
ENV = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_OPTIONAL_LOCKS="0")


class Stop(Exception):
    pass


def run(*cmd, cwd=None):
    try:
        return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, env=ENV)
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 127, "", f"{cmd[0]}: not found")


def git(cwd, *args):
    return run("git", "-C", cwd, *args)


def slug(text, limit=40):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:limit].rstrip("-")


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, data):
    with open(path, "w") as f:
        json.dump(data, f, indent=1)


# ---------- which project and chat am I in ----------

def t3_context():
    tid = os.environ.get("T3CODE_THREAD_ID")
    if not tid or not os.path.exists(T3_DB):
        return None
    try:
        db = sqlite3.connect(f"file:{T3_DB}?mode=ro", uri=True)
        row = db.execute("SELECT project_id, title, payload_json FROM orchestration_v2_projection_threads"
                         " WHERE thread_id = ?", (tid,)).fetchone()
        if not row:
            return None
        root = (json.loads(row[2] or "{}").get("lineage") or {}).get("rootThreadId") or tid
        top = db.execute("SELECT title FROM orchestration_v2_projection_threads WHERE thread_id = ?", (root,)).fetchone()
        proj = db.execute("SELECT title, workspace_root FROM projection_projects WHERE project_id = ?", (row[0],)).fetchone()
    except (sqlite3.Error, ValueError):
        return None
    if not proj:
        return None
    return {"project": slug(proj[0]) or "project", "project_root": proj[1], "chat_id": "t3:" + root,
            "chat_title": (top[0] if top else None) or row[1] or "chat"}


def plain_context():
    cwd = os.getcwd()
    main = main_checkout(cwd)
    if main:  # inside a repo (or one of its worktrees): the repo names the project, its siblings are findable
        project, project_root = os.path.basename(main), os.path.dirname(main)
    else:
        project, project_root = os.path.basename(cwd), cwd
    project = os.environ.get("AGENT_WORKTREE_PROJECT") or project
    for var, kind in (("AGENT_WORKTREE_CHAT", "chat"), ("CLAUDE_CODE_SESSION_ID", "claude"), ("CODEX_THREAD_ID", "codex")):
        if os.environ.get(var):
            return {"project": slug(project) or "project", "project_root": project_root,
                    "chat_id": f"{kind}:{os.environ[var]}", "chat_title": "chat" if kind == "chat" else "session"}
    return {"project": slug(project) or "project", "project_root": project_root, "chat_id": "manual", "chat_title": "manual"}


def context():
    if os.environ.get("AGENT_WORKTREE_CHAT"):
        return plain_context()
    return t3_context() or plain_context()


def chat_dir(ctx):
    """The chat's folder, found by a hash of its id, so a renamed chat keeps its folder."""
    tag = hashlib.sha1(ctx["chat_id"].encode()).hexdigest()[:6]
    pdir = os.path.join(ROOT, ctx["project"])
    if os.path.isdir(pdir):
        for name in sorted(os.listdir(pdir)):
            if name.endswith("-" + tag) and os.path.isdir(os.path.join(pdir, name)):
                return os.path.join(pdir, name)
    return os.path.join(pdir, f"{slug(ctx['chat_title']) or 'chat'}-{tag}")


def main_checkout(path):
    """The main checkout of the repo at path (not a linked worktree), or None."""
    top = git(path, "rev-parse", "--show-toplevel").stdout.strip()
    if not top:
        return None
    common = git(top, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()
    main = os.path.dirname(common) if common.endswith("/.git") else None
    return os.path.realpath(main) if main else None


def find_repo(ctx, name):
    if name in (".", "") or name.startswith(("/", "~", "./", "../")):
        repo = main_checkout(os.path.expanduser(name or "."))
        if not repo:
            raise Stop(f"{name or '.'}: not inside a git repo with a normal .git folder")
        return repo
    bases = [ctx["project_root"], os.path.join(ctx["project_root"], "repos")]
    repos = [os.path.realpath(os.path.join(b, d)) for b in bases if os.path.isdir(b)
             for d in sorted(os.listdir(b)) if os.path.isdir(os.path.join(b, d, ".git"))]
    hits = [r for r in repos if os.path.basename(r) == name] or \
           [r for r in repos if os.path.basename(r).endswith("-" + name)]
    if len(hits) == 1:
        return hits[0]
    known = ", ".join(os.path.basename(r) for r in repos) or "none"
    raise Stop(f"{name}: {'more than one repo matches' if hits else 'no such repo'} in {ctx['project_root']} (repos: {known})")


# ---------- safety ----------

def find_checkouts(path, depth=0):
    if os.path.exists(os.path.join(path, ".git")):
        return [path]
    if depth >= 2:
        return []
    out = []
    try:
        for name in sorted(os.listdir(path)):
            p = os.path.join(path, name)
            if name not in ("node_modules", ".git") and os.path.isdir(p) and not os.path.islink(p):
                out += find_checkouts(p, depth + 1)
    except OSError:
        pass
    return out


def changes(path):
    """Uncommitted changes that count as work, ignoring untracked node_modules and .DS_Store."""
    parts = git(path, "status", "--porcelain=v1", "-z").stdout.split("\0")
    out, skip, noise = [], False, False
    for p in parts:
        if skip or not p:
            skip = False
            continue
        xy, f = p[:2], p[3:]
        skip = xy[0] in "RC"
        if xy == "??" and os.path.basename(f.rstrip("/")) in NOISE:
            noise = True
            continue
        out.append(f"{xy.strip()} {f}")
    return out, noise


def pr_heads(repo, cache):
    url = git(repo, "config", "--get", "remote.origin.url").stdout.strip()
    m = re.search(r"github\.com[:/]([^/]+/[^/]+?)(\.git)?$", url)
    if not m:
        return set()
    if m.group(1) not in cache:
        r = run("gh", "pr", "list", "-R", m.group(1), "--state", "all", "--limit", "1000", "--json", "headRefOid", "-q", ".[].headRefOid")
        cache[m.group(1)] = set(r.stdout.split()) if r.returncode == 0 else set()
    return cache[m.group(1)]


def inspect(co, cache):
    """Facts about one checkout; 'problem' is set when removing it could lose work."""
    c = {"path": co}
    g = os.path.join(co, ".git")
    if os.path.isdir(g):
        c["problem"] = "a full clone, not a worktree (removing it would delete its repo)"
        return c
    try:
        with open(g) as f:
            gitdir = f.read().split("gitdir:", 1)[1].strip()
    except (OSError, IndexError):
        c["problem"] = "unreadable .git file"
        return c
    if not os.path.isdir(gitdir):
        c["problem"] = "its repo no longer knows this worktree"
        return c
    common = git(co, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()
    c["repo"] = common[:-5] if common.endswith("/.git") else common
    c["head"] = git(co, "rev-parse", "HEAD").stdout.strip()
    c["branch"] = git(co, "symbolic-ref", "-q", "--short", "HEAD").stdout.strip() or None
    c["activity"] = max((os.stat(os.path.join(gitdir, k)).st_mtime for k in ("HEAD", "index", "logs/HEAD")
                         if os.path.exists(os.path.join(gitdir, k))), default=0)
    real, noise = changes(co)
    c["force"] = noise
    if real:
        c["problem"] = f"{len(real)} uncommitted changes: " + ", ".join(real[:3])
        return c
    on_remote = git(co, "for-each-ref", "--contains", c["head"], "--count=1", "--format=%(refname)", "refs/remotes").stdout.strip()
    if not on_remote and c["head"] not in pr_heads(c["repo"], cache):
        n = git(co, "rev-list", "--count", c["head"], "--not", "--remotes").stdout.strip()
        c["problem"] = f"{c['branch'] or 'detached HEAD'}: {n} commits not on any remote branch"
    return c


def only_records(path):
    return all(f in RECORDS for _, _, fs in os.walk(path) for f in fs)


def subdirs(path):
    try:
        return [n for n in sorted(os.listdir(path)) if not n.startswith(".")
                and os.path.isdir(os.path.join(path, n)) and not os.path.islink(os.path.join(path, n))]
    except OSError:
        return []


def remove_task(tdir):
    """Remove a task folder if every checkout in it is safe; return the problems otherwise."""
    cache = {}
    checkouts = [inspect(co, cache) for co in find_checkouts(tdir)]
    problems = [f"{c['path']}: {c['problem']}" for c in checkouts if c.get("problem")]
    if problems:
        return problems
    for c in checkouts:
        r = git(c["repo"], "worktree", "remove", *(["--force"] if c["force"] else []), c["path"])
        if r.returncode:
            return [f"{c['path']}: git worktree remove failed: {r.stderr.strip()[:200]}"]
    for co in read_json(os.path.join(tdir, TASK_FILE), {}).get("checkouts", []):
        if os.path.isdir(co.get("repo", "")):
            git(co["repo"], "worktree", "prune")  # a checkout someone deleted by hand
    if os.path.isdir(tdir) and only_records(tdir):
        shutil.rmtree(tdir)
    cdir = os.path.dirname(tdir)
    if os.path.isdir(cdir) and not subdirs(cdir) and only_records(cdir):
        shutil.rmtree(cdir)
    return []


# ---------- commands ----------

def default_ref(repo):
    return git(repo, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD").stdout.strip() or "origin/main"


def new(task, specs, branch, fetch):
    if slug(task) != task:
        raise Stop(f"task name must look like '{slug(task) or 'my-task'}' (lowercase letters, digits, dashes)")
    ctx = context()
    tdir = os.path.join(chat_dir(ctx), task)
    plans = []
    for spec in specs or ["."]:
        name, _, ref = spec.partition("=")
        repo = find_repo(ctx, name)
        dest = os.path.join(tdir, os.path.basename(repo))
        if os.path.exists(dest) or any(p["dest"] == dest for p in plans):
            raise Stop(f"{dest} already exists")
        plans.append({"repo": repo, "dest": dest, "ref": ref})
    if fetch:
        for repo in sorted({p["repo"] for p in plans}):
            r = git(repo, "fetch", "--quiet", "origin")
            if r.returncode:
                raise Stop(f"git fetch failed in {repo}: {r.stderr.strip()[:300]}\n"
                           f"Fetch it yourself (`git -C '{repo}' fetch origin`), then rerun with --no-fetch.")
    for p in plans:
        explicit = bool(p["ref"])
        p["ref"] = p["ref"] or default_ref(p["repo"])
        if git(p["repo"], "rev-parse", "--verify", "--quiet", p["ref"] + "^{commit}").returncode:
            raise Stop(f"{os.path.basename(p['repo'])}: unknown ref {p['ref']}")
        p["made_branch"] = False
        if not branch:
            p["args"] = ["--detach", p["dest"], p["ref"]]
            continue
        if f"branch refs/heads/{branch}\n" in git(p["repo"], "worktree", "list", "--porcelain").stdout + "\n":
            raise Stop(f"{os.path.basename(p['repo'])}: branch {branch} is already checked out in another worktree")
        if git(p["repo"], "show-ref", "--verify", "--quiet", f"refs/heads/{branch}").returncode == 0:
            if explicit:
                raise Stop(f"{os.path.basename(p['repo'])}: branch {branch} already exists; drop ={p['ref']} to use it")
            p["ref"], p["args"] = branch, [p["dest"], branch]
        elif not explicit and git(p["repo"], "show-ref", "--verify", "--quiet", f"refs/remotes/origin/{branch}").returncode == 0:
            p["ref"], p["made_branch"] = f"origin/{branch}", True
            p["args"] = ["--track", "-b", branch, p["dest"], p["ref"]]
        else:
            p["made_branch"], p["args"] = True, ["--no-track", "-b", branch, p["dest"], p["ref"]]
    existed = os.path.isdir(tdir)
    os.makedirs(tdir, exist_ok=True)
    made = []
    for p in plans:
        r = git(p["repo"], "worktree", "add", "--quiet", *p["args"])
        if r.returncode:
            for q in made:  # leave nothing half made
                git(q["repo"], "worktree", "remove", "--force", q["dest"])
                if q["made_branch"]:
                    git(q["repo"], "branch", "-D", branch)
            if not existed:
                shutil.rmtree(tdir, ignore_errors=True)
                cdir = os.path.dirname(tdir)
                if os.path.isdir(cdir) and not subdirs(cdir) and only_records(cdir):
                    shutil.rmtree(cdir)
            raise Stop(f"git worktree add failed in {p['repo']}: {r.stderr.strip()[:300]}")
        made.append(p)
    cdir = os.path.dirname(tdir)
    write_json(os.path.join(cdir, CHAT_FILE), {"chat_id": ctx["chat_id"], "title": ctx["chat_title"],
                                               "project": ctx["project"], "project_root": ctx["project_root"]})
    rec = read_json(os.path.join(tdir, TASK_FILE), {"task": task, "checkouts": []})
    for p in plans:
        rec["checkouts"].append({"repo": p["repo"], "path": p["dest"], "branch": branch, "ref": p["ref"],
                                 "created": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    write_json(os.path.join(tdir, TASK_FILE), rec)
    for p in plans:
        print(f"{p['dest']}  ({'branch ' + branch if branch else 'detached'} at {p['ref']})")
    print(f"When this work is pushed: agent-worktree done {task}")


def done(task):
    tdir = os.path.join(chat_dir(context()), task)
    if not os.path.isdir(tdir):
        raise Stop(f"no task {task} in {os.path.dirname(tdir)}")
    problems = remove_task(tdir)
    if problems:
        raise Stop("kept everything, nothing removed:\n" + "\n".join(f"- {p}" for p in problems))
    print(f"removed {tdir}")


def show(cdir):
    print(cdir)
    for task in subdirs(cdir):
        print(f"  {task}/")
        for co in find_checkouts(os.path.join(cdir, task)):
            branch = git(co, "symbolic-ref", "-q", "--short", "HEAD").stdout.strip() or "detached"
            real, _ = changes(co)
            print(f"    {os.path.basename(co)}: {branch}" + (f", {len(real)} uncommitted" if real else ""))


def list_cmd(all_chats):
    if all_chats:
        chats = [os.path.join(ROOT, p, c) for p in subdirs(ROOT) for c in subdirs(os.path.join(ROOT, p))]
        for c in chats:
            show(c)
        if not chats:
            print(f"no worktrees in {ROOT}")
        return
    cdir = chat_dir(context())
    if os.path.isdir(cdir):
        show(cdir)
    else:
        print(f"no worktrees yet for this chat ({cdir})")


def cwds_in_use():
    out = run("lsof", "-nP", "-d", "cwd", "-Fn").stdout
    return {l[1:] for l in out.splitlines() if l.startswith("n" + ROOT + "/")}


def touched_within(path, seconds):
    cutoff = time.time() - seconds
    for dp, dns, fns in os.walk(path):
        dns[:] = [d for d in dns if d not in ("node_modules", ".git")]
        for n in fns:
            if n == ".DS_Store":
                continue
            try:
                if os.lstat(os.path.join(dp, n)).st_mtime > cutoff:
                    return os.path.relpath(os.path.join(dp, n), path)
            except OSError:
                pass
    return None


def clean(idle_hours, dry_run):
    cwds, cache, counts = cwds_in_use(), {}, {"removed": 0, "kept": 0}
    for p in subdirs(ROOT):
        for c in subdirs(os.path.join(ROOT, p)):
            for t in subdirs(os.path.join(ROOT, p, c)):
                tdir, name = os.path.join(ROOT, p, c, t), f"{p}/{c}/{t}"
                checkouts = [inspect(co, cache) for co in find_checkouts(tdir)]
                recent = touched_within(tdir, idle_hours * 3600)
                git_recent = any(time.time() - x.get("activity", 0) < idle_hours * 3600 for x in checkouts if x.get("head"))
                problems = [f"{os.path.basename(x['path'])}: {x['problem']}" for x in checkouts if x.get("problem")]
                if any(w == tdir or w.startswith(tdir + "/") for w in cwds):
                    reason = "a process is working in it"
                elif recent or git_recent:
                    reason = f"used in the last {idle_hours} h" + (f" ({recent})" if recent else "")
                elif problems:
                    reason = "; ".join(problems)
                else:
                    reason = None
                if reason:
                    counts["kept"] += 1
                    print(f"kept     {name}: {reason}")
                    continue
                if dry_run:
                    counts["removed"] += 1
                    print(f"would remove {name}")
                    continue
                left = remove_task(tdir)
                counts["removed" if not left else "kept"] += 1
                print(f"removed  {name}" if not left else f"kept     {name}: {'; '.join(left)}")
    verb = "would remove" if dry_run else "removed"
    print(f"{verb} {counts['removed']}, kept {counts['kept']}")


def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("", [])
    if cmd == "new" and args:
        branch, fetch = None, True
        if "--no-fetch" in args:
            args.remove("--no-fetch")
            fetch = False
        if "--branch" in args:
            i = args.index("--branch")
            if i + 1 >= len(args):
                raise Stop("--branch needs a name")
            branch = args[i + 1]
            del args[i:i + 2]
        new(args[0], args[1:], branch, fetch)
    elif cmd == "done" and len(args) == 1:
        done(args[0])
    elif cmd == "list" and args in ([], ["--all"]):
        list_cmd(bool(args))
    elif cmd == "clean":
        hours, dry = 24, "--dry-run" in args
        if "--idle-hours" in args:
            i = args.index("--idle-hours")
            if i + 1 >= len(args) or not args[i + 1].isdigit():
                raise Stop("--idle-hours needs a whole number")
            hours = int(args[i + 1])
        clean(hours, dry)
    elif cmd in ("-h", "--help", "help"):
        print(__doc__)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Stop as e:
        sys.exit(f"agent-worktree: {e}")
